<div class="page-width section">
  {%- if cart.item_count > 0 -%}
    <div class="page-hero" style="padding-top: 0;">
      <h1>{{ 'cart.general.title' | t }}</h1>
    </div>

    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-items">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a href="{{ item.url }}" class="cart-item__image">
              {%- if item.image -%}
                {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.image.alt | escape }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div>
              <div class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
              {%- unless item.product.has_only_default_variant -%}
                <div class="cart-item__meta">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="quantity-row">
                <div class="quantity">
                  <button type="button" data-quantity-change="-1" aria-label="Decrease quantity">&minus;</button>
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    data-cart-quantity
                    aria-label="{{ 'products.product.quantity' | t }}"
                  >
                  <button type="button" data-quantity-change="1" aria-label="Increase quantity">+</button>
                </div>
                <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.general.remove' | t }}</a>
              </div>
            </div>
            <div class="cart-item__price">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-footer">
        <div class="cart-footer__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-footer__note">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
        <button type="submit" name="checkout" class="button">{{ 'cart.general.checkout' | t }}</button>
      </div>
    </form>
  {%- else -%}
    <div class="cart-empty">
      <h1>{{ 'cart.general.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
