{% comment %}
  Hero — Landing
  Full-width hero for the top of the home page.
  White background, product image centerpiece, CTA button in the middle,
  headline + subheadline above and trust badges below.
  Everything is editable in the theme customizer.
{% endcomment %}

<style>
  #Hero-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: clamp(2.5rem, 6vw, 5rem) 1.25rem clamp(2rem, 4vw, 3.5rem);
  }

  #Hero-{{ section.id }} .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #Hero-{{ section.id }} .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    background: {{ section.settings.accent_color | color_modify: 'alpha', 0.08 }};
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.25 }};
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    margin-bottom: 1.25rem;
  }

  #Hero-{{ section.id }} .hero-heading {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: {{ section.settings.text_color }};
    margin: 0 0 1rem;
  }

  #Hero-{{ section.id }} .hero-subheading {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.55;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.65 }};
    max-width: 40rem;
    margin: 0 auto;
  }

  #Hero-{{ section.id }} .hero-media {
    position: relative;
    width: 100%;
    max-width: 980px;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  #Hero-{{ section.id }} .hero-media img,
  #Hero-{{ section.id }} .hero-media svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
  }

  #Hero-{{ section.id }} .hero-cta {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  #Hero-{{ section.id }} .hero-cta--below {
    position: static;
    transform: none;
    margin-top: 1.75rem;
  }

  #Hero-{{ section.id }} .hero-button {
    display: inline-block;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 1rem 2.75rem;
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  #Hero-{{ section.id }} .hero-button:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.24);
  }

  #Hero-{{ section.id }} .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 3rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  #Hero-{{ section.id }} .hero-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
  }

  #Hero-{{ section.id }} .hero-badge svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: {{ section.settings.accent_color }};
  }

  @media (max-width: 600px) {
    #Hero-{{ section.id }} .hero-button {
      padding: 0.85rem 2.1rem;
      font-size: 0.95rem;
    }
  }
</style>

<div id="Hero-{{ section.id }}">
  <div class="hero-inner">
    {% if section.settings.eyebrow != blank %}
      <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hero-heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="hero-media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1960
          | image_tag: loading: 'eager', sizes: '(max-width: 1000px) 100vw, 980px', alt: section.settings.heading
        }}
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_position == 'middle' %}
        <div class="hero-cta">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero-button">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank and section.settings.button_position == 'below' %}
      <div class="hero-cta hero-cta--below">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero-button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

    {% if section.settings.show_badges %}
      <div class="hero-badges">
        {% if section.settings.badge_1 != blank %}
          <span class="hero-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="6" width="14" height="11" rx="1"/><path d="M15 9h4l3 3v5h-7z"/><circle cx="6" cy="19" r="1.8"/><circle cx="18.5" cy="19" r="1.8"/></svg>
            {{ section.settings.badge_1 }}
          </span>
        {% endif %}
        {% if section.settings.badge_2 != blank %}
          <span class="hero-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l7 4v6c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
            {{ section.settings.badge_2 }}
          </span>
        {% endif %}
        {% if section.settings.badge_3 != blank %}
          <span class="hero-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
            {{ section.settings.badge_3 }}
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero — Landing",
  "tag": "section",
  "class": "section-hero-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Free shipping on all orders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Time, Simplified."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Minimal LED watches designed for everyday wear. Lightweight, water-resistant and built to keep up with you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to your All Products collection if left empty."
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Button position",
      "options": [
        { "value": "middle", "label": "Middle of image" },
        { "value": "below", "label": "Below image" }
      ],
      "default": "middle"
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge 1",
      "default": "Free tracked shipping"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Badge 2",
      "default": "12-month warranty"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Badge 3",
      "default": "30-day easy returns"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2563eb"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero — Landing"
    }
  ]
}
{% endschema %}
