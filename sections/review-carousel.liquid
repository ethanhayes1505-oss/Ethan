{%- comment -%}
  Review carousel: a horizontally scrollable row of review cards with
  prev/next arrows, swipe/trackpad scrolling and scroll-snap.
  Each review is a block, so reviews can be added, edited, reordered or
  removed from the theme editor. The headline score is averaged from the blocks.
{%- endcomment -%}

{%- liquid
  assign review_count = 0
  assign rating_total = 0
  for block in section.blocks
    assign review_count = review_count | plus: 1
    assign rating_total = rating_total | plus: block.settings.rating
  endfor
  if review_count > 0
    assign average = rating_total | times: 1.0 | divided_by: review_count | round: 1
  endif
-%}

<style>
  #rc-{{ section.id }} {
    --rc-bg: {{ section.settings.background }};
    --rc-card: {{ section.settings.card_background }};
    --rc-text: {{ section.settings.text_color }};
    --rc-star: {{ section.settings.star_color }};
    --rc-star-off: #dcdce6;
    background: var(--rc-bg);
    color: var(--rc-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    text-align: center;
  }
  #rc-{{ section.id }} .rc__title { margin: 0 0 .4rem; font-weight: 400; }
  #rc-{{ section.id }} .rc__summary {
    display: flex; align-items: center; justify-content: center; gap: .6rem;
    flex-wrap: wrap; margin-bottom: 1.6rem; font-size: 1.05rem;
  }
  #rc-{{ section.id }} .rc__score { font-weight: 700; font-size: 1.5rem; }
  #rc-{{ section.id }} .rc__count { opacity: .7; font-size: .9rem; }

  #rc-{{ section.id }} .rc__stars { display: inline-flex; gap: 2px; }
  #rc-{{ section.id }} .rc__star {
    width: 22px; height: 22px; background: var(--rc-star-off);
    display: inline-flex; align-items: center; justify-content: center;
  }
  #rc-{{ section.id }} .rc__star--on { background: var(--rc-star); }
  #rc-{{ section.id }} .rc__star svg { width: 15px; height: 15px; fill: #fff; }
  #rc-{{ section.id }} .rc__summary .rc__star { width: 18px; height: 18px; }
  #rc-{{ section.id }} .rc__summary .rc__star svg { width: 12px; height: 12px; }

  #rc-{{ section.id }} .rc__track {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; -webkit-overflow-scrolling: touch;
    padding: 4px 16px 8px; scroll-padding: 0 16px; scrollbar-width: none;
    max-width: 1200px; margin: 0 auto;
  }
  #rc-{{ section.id }} .rc__track::-webkit-scrollbar { display: none; }

  #rc-{{ section.id }} .rc__card {
    flex: 0 0 calc(100% - 8px); scroll-snap-align: start;
    background: var(--rc-card); border-radius: 4px;
    padding: 1.4rem 1.2rem; box-sizing: border-box;
    display: flex; flex-direction: column; align-items: center; gap: .8rem;
  }
  @media (min-width: 750px) {
    #rc-{{ section.id }} .rc__card { flex-basis: calc((100% - 16px) / 2); }
  }
  @media (min-width: 1100px) {
    #rc-{{ section.id }} .rc__card { flex-basis: calc((100% - 32px) / 3); }
  }
  #rc-{{ section.id }} .rc__heading { margin: 0; font-size: 1.05rem; font-weight: 600; }
  #rc-{{ section.id }} .rc__body { margin: 0; line-height: 1.6; flex: 1; }
  #rc-{{ section.id }} .rc__author {
    width: 100%; margin: 0; padding-top: .8rem;
    border-top: 1px solid rgba(0,0,0,.08); font-style: italic; font-weight: 700;
  }

  #rc-{{ section.id }} .rc__nav { display: flex; justify-content: center; gap: 1.5rem; margin-top: 1rem; }
  #rc-{{ section.id }} .rc__arrow {
    background: none; border: 0; padding: 6px; cursor: pointer; color: var(--rc-text);
    line-height: 0; transition: opacity .2s;
  }
  #rc-{{ section.id }} .rc__arrow svg { width: 26px; height: 26px; }
  #rc-{{ section.id }} .rc__arrow:disabled { opacity: .3; cursor: default; }
</style>

{%- capture star_svg -%}
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7.3L12 17.8 5.8 21.5l1.6-7.3L2 9.5l7.1-.6z"/></svg>
{%- endcapture -%}

<section id="rc-{{ section.id }}" class="rc" aria-roledescription="carousel" aria-label="{{ section.settings.title | escape }}">
  {%- if section.settings.title != blank -%}
    <h2 class="rc__title h2">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  {%- if review_count > 0 and section.settings.show_summary -%}
    <div class="rc__summary">
      <span>{{ section.settings.summary_label | escape }}</span>
      <span class="rc__score">{{ average }} / 5</span>
      <span class="rc__stars" aria-hidden="true">
        {%- assign full_stars = average | round -%}
        {%- for i in (1..5) -%}
          <span class="rc__star{% if i <= full_stars %} rc__star--on{% endif %}">{{ star_svg }}</span>
        {%- endfor -%}
      </span>
      <span class="rc__count">({{ review_count }} reviews)</span>
    </div>
  {%- endif -%}

  <div class="rc__track" data-rc-track tabindex="0">
    {%- for block in section.blocks -%}
      <article class="rc__card" {{ block.shopify_attributes }} aria-label="{{ block.settings.rating }} out of 5 stars">
        <span class="rc__stars">
          {%- for i in (1..5) -%}
            <span class="rc__star{% if i <= block.settings.rating %} rc__star--on{% endif %}">{{ star_svg }}</span>
          {%- endfor -%}
        </span>
        {%- if block.settings.heading != blank -%}
          <h3 class="rc__heading">{{ block.settings.heading | escape }}</h3>
        {%- endif -%}
        <p class="rc__body">{{ block.settings.text | escape }}</p>
        {%- if block.settings.author != blank -%}
          <p class="rc__author">{{ block.settings.author | escape }}</p>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>

  <div class="rc__nav">
    <button type="button" class="rc__arrow" data-rc-prev aria-label="Previous reviews">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4l-8 8 8 8"/></svg>
    </button>
    <button type="button" class="rc__arrow" data-rc-next aria-label="Next reviews">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4l8 8-8 8"/></svg>
    </button>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('rc-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-rc-track]');
    var prev = root.querySelector('[data-rc-prev]');
    var next = root.querySelector('[data-rc-next]');

    function step() {
      var card = track.querySelector('.rc__card');
      return card ? card.getBoundingClientRect().width + 16 : track.clientWidth;
    }
    function update() {
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }
    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); prev.click(); }
      if (e.key === 'ArrowRight') { e.preventDefault(); next.click(); }
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Review carousel",
  "tag": "div",
  "class": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Customer reviews" },
    { "type": "checkbox", "id": "show_summary", "label": "Show average rating", "default": true },
    { "type": "text", "id": "summary_label", "label": "Rating label", "default": "Excellent" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdf8f5" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f5eae8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3a2a2a" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#00b67a" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Share positive thoughts and feedback from your customer." },
        { "type": "text", "id": "author", "label": "Author", "default": "Author" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review carousel",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "heading": "Exactly as described", "text": "Jacket arrived in perfect condition, even better than the photos. Well packaged and quick to arrive.", "author": "Sophie M." } },
        { "type": "review", "settings": { "rating": 5, "heading": "Super fast delivery", "text": "Ordered on Monday, had it by Wednesday. Item was clean and folded nicely. Will be ordering again.", "author": "James T." } },
