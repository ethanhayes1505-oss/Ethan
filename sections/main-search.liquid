<div class="page-width section">
  <div class="page-hero" style="padding-top: 0;">
    <h1>{{ 'general.search.title' | t }}</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      aria-label="{{ 'general.search.placeholder' | t }}"
    >
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 16 -%}
      {%- if search.results_count == 0 -%}
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <p>{{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="product-grid" style="--grid-cols: 4; margin-top: 3.2rem;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item, placeholder_index: forloop.index %}
            {%- else -%}
              <div>
                <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                <p class="product-card__price">{{ item.content | strip_html | truncate: 120 }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search page",
  "settings": []
}
{% endschema %}
