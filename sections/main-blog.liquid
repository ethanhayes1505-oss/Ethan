<div class="page-width section">
  <div class="page-hero" style="padding-top: 0;">
    <h1>{{ blog.title }}</h1>
  </div>

  {%- paginate blog.articles by 9 -%}
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <article class="article-card">
          <a href="{{ article.url }}">
            <div class="article-card__image">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.image.alt | escape }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <span class="article-card__date">{{ article.published_at | date: format: 'abbreviated_date' }}</span>
            <h3>{{ article.title }}</h3>
            <p class="product-card__price">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </a>
        </article>
      {%- endfor -%}
    </div>

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog page",
  "settings": []
}
{% endschema %}
