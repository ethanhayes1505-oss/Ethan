<div class="page-width">
  <div class="page-hero">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description | strip_html }}</p>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-toolbar">
      <span>{{ 'collections.general.product_count' | t: count: collection.products_count }}</span>
      <form method="get" action="{{ collection.url }}">
        <label for="SortBy" class="visually-hidden">{{ 'collections.general.sort_by' | t }}</label>
        <select id="SortBy" name="sort_by" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid" style="--grid-cols: {{ section.settings.columns }};">
        {%- for product in collection.products -%}
          {% render 'product-card', card_product: product, placeholder_index: forloop.index %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>{{ 'collections.general.no_products' | t }}</p>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    }
  ]
}
{% endschema %}
