<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <h4>{{ shop.name }}</h4>
        {%- if section.settings.about_text != blank -%}
          <p>{{ section.settings.about_text }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.menu_1 != blank -%}
        <div>
          <h4>{{ section.settings.menu_1.title }}</h4>
          <ul>
            {%- for link in section.settings.menu_1.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.menu_2 != blank -%}
        <div>
          <h4>{{ section.settings.menu_2.title }}</h4>
          <ul>
            {%- for link in section.settings.menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div>
          <h4>{{ section.settings.newsletter_heading | escape }}</h4>
          {% form 'customer', class: 'footer-newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p>{{ 'general.newsletter.success' | t }}</p>
            {%- else -%}
              <div class="newsletter-form">
                <input
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ 'general.newsletter.label' | t }}"
                  aria-label="{{ 'general.newsletter.label' | t }}"
                  autocomplete="email"
                  required
                >
                <button type="submit" class="button">{{ 'general.newsletter.button' | t }}</button>
              </div>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}
    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}</span>
      <span>
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}">Instagram</a>&nbsp;&nbsp;
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}">TikTok</a>&nbsp;&nbsp;
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}">Facebook</a>
        {%- endif -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "A short sentence about your shop — what you sell and who it's for."
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "First menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Second menu"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the loop"
    }
  ]
}
{% endschema %}
