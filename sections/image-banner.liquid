<div class="hero{% if section.settings.height == 'tall' %} hero--tall{% endif %}">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', alt: section.settings.image.alt | escape }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="page-width" style="width: 100%;">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "tall"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Considered pieces, built to last"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A short line about your shop. Swap this image and text in the theme editor."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    { "name": "Image banner" }
  ]
}
{% endschema %}
