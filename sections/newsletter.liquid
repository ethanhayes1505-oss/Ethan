<div class="section newsletter">
  <div class="page-width">
    <div class="newsletter__inner">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p>{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="newsletter-form">
            <input
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ 'general.newsletter.label' | t }}"
              aria-label="{{ 'general.newsletter.label' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="button">{{ 'general.newsletter.button' | t }}</button>
          </div>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Be first to hear about new drops, restocks and offers."
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
