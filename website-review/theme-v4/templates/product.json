    "faq": {
      "type": "sl-faq",
      "blocks": {
        "q1": { "type": "question", "settings": { "question": "Shipping", "answer": "<p>Free standard shipping on every US order. Orders are processed within 1 business day.</p>" } },
        "q2": { "type": "question", "settings": { "question": "30-day returns", "answer": "<p>Not right for you? <a href=\"/pages/contact\">Contact us</a> within 30 days of delivery to start a return.</p>" } },
        "q3": { "type": "question", "settings": { "question": "How do I set the alarm?", "answer": "<p>Set your wake-up time on the band itself. The quick-start guide walks you through it.</p>" } },
        "q4": { "type": "question", "settings": { "question": "Will it wake my partner?", "answer": "<p>It's designed not to. The vibration is felt on your wrist, not heard across the room.</p>" } },
        "q6": { "type": "question", "settings": { "question": "I sleep through alarms. Will this wake me?", "answer": "<p>It buzzes on your wrist, so you feel it rather than hear it, and many people notice that more than a sound. Everyone sleeps differently, so if it doesn't work for you, send it back within 30 days for a full refund.</p>" } },
        "q7": { "type": "question", "settings": { "question": "Will it wake the baby?", "answer": "<p>There's no ringtone. The alarm is a vibration on your wrist, not a sound across the room, so it's made to reach only you. If it doesn't suit your home, send it back within 30 days.</p>" } },
        "q5": { "type": "question", "settings": { "question": "How do I charge it?", "answer": "<p>Use the included USB cable. Charge it during the day and wear it at night.</p>" } }
