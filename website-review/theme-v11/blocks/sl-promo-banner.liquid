{%- comment -%}
  SL Promo banner: one coloured strip above the bundle picker. Leave the text empty to hide it.
{%- endcomment -%}
{%- if block.settings.text != blank -%}
<p class="sl-pb" style="--c:{{ block.settings.color }}" {{ block.shopify_attributes }}>
  {%- if block.settings.label != blank -%}<strong>{{ block.settings.label }}</strong> {% endif -%}
  {{ block.settings.text }}
</p>
<style>
  .sl-pb{margin:0;width:100%;padding:12px 16px;border-radius:12px;background:var(--c);color:#fff;font-size:.95rem;font-weight:500;line-height:1.3}
  .sl-pb strong{font-weight:700;letter-spacing:.02em}
</style>
{%- endif -%}
{% schema %}
{
  "name": "SL Promo banner",
  "settings": [
    { "type": "text", "id": "label", "label": "Bold label", "default": "BLACK FRIDAY:" },
    { "type": "text", "id": "text", "label": "Text", "info": "Only say what is true on the page. Leave empty to hide the banner.", "default": "Save up to $29.98 on bundles" },
    { "type": "color", "id": "color", "label": "Banner colour", "default": "#B4531F" }
  ],
  "presets": [{ "name": "SL Promo banner" }]
}
{% endschema %}
