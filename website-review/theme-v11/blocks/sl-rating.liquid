{%- comment -%}
  SL Rating row: stars, average and review count above the product title.
  The numbers are typed in by hand. Keep them equal to the reviews shown on the page.
{%- endcomment -%}
{%- assign r = block.settings.rating | times: 1.0 -%}
{%- if r > 0 -%}
<button type="button" class="sl-rt" {{ block.shopify_attributes }}
  aria-label="Rated {{ block.settings.rating }} out of 5 from {{ block.settings.count }} reviews. Go to reviews."
  onclick="var t=document.querySelector('.sl-reviews');if(t){t.scrollIntoView({behavior:'smooth'})}">
  <strong class="sl-rt__avg">{{ block.settings.rating }}/5</strong>
  <span class="sl-rt__stars" aria-hidden="true" style="--p:{{ r | times: 20 | round }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
  <span class="sl-rt__count">{{ block.settings.count }} reviews</span>
</button>
<style>
  .sl-rt{display:inline-flex;align-items:center;gap:8px;margin:0;padding:0;border:0;background:none;cursor:pointer;font:inherit;font-size:.92rem;line-height:1;color:#1E2A44}
  .sl-rt__avg{font-weight:700}
  .sl-rt__stars{font-size:1.05rem;letter-spacing:2px;background:linear-gradient(90deg,#E0A32E var(--p),#d9d0c2 var(--p));-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
  .sl-rt__count{color:#5d6273;text-decoration:underline;text-underline-offset:3px;text-decoration-color:#c9c0b2}
</style>
{%- endif -%}
{% schema %}
{
  "name": "SL Rating row",
  "settings": [
    { "type": "text", "id": "rating", "label": "Average rating", "info": "Out of 5, e.g. 4.8. Work it out from the reviews shown on the page.", "default": "4.8" },
    { "type": "text", "id": "count", "label": "Number of reviews", "info": "Must match the number of reviews shown on the page.", "default": "9" }
  ],
  "presets": [{ "name": "SL Rating row" }]
}
{% endschema %}
