<script>
  // slide carousels (hero + buy-box gallery)
  document.querySelectorAll('[data-carousel]').forEach(function(car){
    var track = car.querySelector('.car-track');
    var slides = car.querySelectorAll('.car-slide');
    var dotsBox = car.querySelector('.car-dots');
    var i = 0, timer = null, auto = parseInt(car.dataset.auto || '0', 10);
    slides.forEach(function(_, n){
      var d = document.createElement('button');
      d.className = 'car-dot' + (n === 0 ? ' on' : '');
      d.setAttribute('aria-label', 'Go to slide ' + (n + 1));
      d.addEventListener('click', function(){ go(n); restart(); });
      dotsBox.appendChild(d);
    });
    function go(n){
      i = (n + slides.length) % slides.length;
      track.style.transform = 'translateX(-' + (i * 100) + '%)';
      dotsBox.querySelectorAll('.car-dot').forEach(function(d, k){
        d.classList.toggle('on', k === i);
      });
    }
    function restart(){
      if (!auto) return;
      clearInterval(timer);
      timer = setInterval(function(){ go(i + 1); }, auto);
    }
    car.querySelector('.car-prev').addEventListener('click', function(){ go(i - 1); restart(); });
    car.querySelector('.car-next').addEventListener('click', function(){ go(i + 1); restart(); });
    restart();
  });

  // reviews carousel (scrolls one card at a time)
  function revScroll(dir){
    var track = document.getElementById('revTrack');
    var card = track.querySelector('.rcard');
    track.scrollBy({ left: dir * (card.offsetWidth + 24), behavior: 'smooth' });
  }
</script>

