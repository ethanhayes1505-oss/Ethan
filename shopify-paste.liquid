{% comment %}
  PASTE THIS WHOLE FILE into a "Custom Liquid" section in the Shopify theme editor.
  Your theme already has its own header, announcement bar and footer —
  so those parts of the design are OPTIONAL below and marked with comments.
  Delete them if you don't want doubles.

  TO MAKE THE BUY BUTTON WORK:
  1. In Shopify admin go to Products -> Add product, and create your product
     (name, price, photos), then click Save.
  2. Open the product in your store and look at its web address — the last part
     is the "handle", e.g. yourstore.com/products/shock-alarm-bracelet
                                                  ^^^^^^^^^^^^^^^^^^^^
  3. On the line just below this comment, replace CHANGE-ME-product-handle
     with your handle (keep the quotes). The ADD TO CART button then becomes a
     real working button showing the live price, and the fake [£XX.XX] prices
     update automatically too.
{% endcomment %}
{% assign dl_product = all_products['CHANGE-ME-product-handle'] %}

<style>
  :root{
    --ink:#0a1630;          /* midnight navy */
    --ink-soft:#101f42;     /* dark section bg */
    --paper:#f5f8fd;        /* ice-white bg */
    --card:#ffffff;
    --accent:#ffb020;       /* sunrise amber CTA */
    --accent-dark:#e09407;
    --accent-soft:#fff3da;
    --accent-ink:#0a1630;   /* text on amber buttons */
    --blue:#2456d6;         /* secondary accent */
    --green:#16a34a;
    --muted:#5a6478;
    --line:#e2e8f2;
    --star:#ffb020;
    --radius:14px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:var(--paper);line-height:1.6}
  img{max-width:100%}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1140px;margin:0 auto;padding:0 20px}
  section{padding:72px 0}
  h1,h2,h3{line-height:1.15;letter-spacing:-.02em}
  h2{font-size:clamp(26px,4vw,38px);margin-bottom:14px}
  .sub{color:var(--muted);font-size:17px;max-width:640px}
  .center{text-align:center}
  .center .sub{margin:0 auto}

  /* placeholders */
  .ph{background:repeating-linear-gradient(45deg,#eef2f9,#eef2f9 12px,#e4eaf5 12px,#e4eaf5 24px);border:2px dashed #aebedb;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:#6b7a99;font-weight:600;font-size:14px;text-align:center;padding:16px}
  .ph-txt{color:var(--accent-dark);background:var(--accent-soft);border-radius:6px;padding:0 6px;font-style:italic}

  /* announcement bar */
  .bar{background:var(--ink);color:#fff;font-size:13.5px;font-weight:600;text-align:center;padding:9px 14px;letter-spacing:.02em}
  .bar span{color:var(--accent)}

  /* header */
  header{background:var(--paper);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50}
  .nav{display:flex;align-items:center;justify-content:space-between;height:64px}
  .logo{font-size:21px;font-weight:800;letter-spacing:-.03em}
  .logo em{color:var(--accent-dark);font-style:normal}
  .nav-links{display:flex;gap:28px;font-size:15px;font-weight:500}
  .nav-links a:hover{color:var(--blue)}
  .btn{display:inline-block;background:var(--accent);color:var(--accent-ink);font-weight:800;padding:14px 30px;border-radius:999px;font-size:16px;border:none;cursor:pointer;transition:.15s;box-shadow:0 6px 18px rgba(255,176,32,.4)}
  .btn:hover{background:var(--accent-dark);transform:translateY(-1px)}
  .btn-sm{padding:9px 20px;font-size:14px;box-shadow:none}
  .btn-ghost{background:transparent;color:var(--ink);border:2px solid var(--ink);box-shadow:none}
  .btn-ghost:hover{background:var(--ink);color:#fff}

  /* carousel */
  .carousel{position:relative;border-radius:var(--radius);overflow:hidden}
  .car-track{display:flex;transition:transform .45s ease}
  .car-slide{flex:0 0 100%}
  .car-slide .ph{border-radius:0;height:100%}
  .car-btn{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;border:none;background:rgba(255,255,255,.92);color:var(--ink);font-size:20px;font-weight:800;cursor:pointer;z-index:5;box-shadow:0 4px 14px rgba(10,22,48,.25);display:flex;align-items:center;justify-content:center;transition:.15s}
  .car-btn:hover{background:var(--accent)}
  .car-prev{left:14px}
  .car-next{right:14px}
  .car-dots{position:absolute;bottom:14px;left:0;right:0;display:flex;gap:8px;justify-content:center;z-index:5}
  .car-dot{width:9px;height:9px;border-radius:50%;border:none;background:rgba(255,255,255,.5);cursor:pointer;padding:0;transition:.15s}
  .car-dot.on{background:var(--accent);transform:scale(1.25)}

  /* hero */
  .hero{background:var(--ink);color:#fff;padding:80px 0}
  .hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
  .stars{color:var(--star);letter-spacing:2px;font-size:16px}
  .rating-line{display:flex;align-items:center;gap:10px;font-size:14px;color:#bcc7dd;margin-bottom:18px;font-weight:600}
  .hero h1{font-size:clamp(34px,5vw,54px);font-weight:800;margin-bottom:18px}
  .hero h1 em{color:var(--accent);font-style:normal}
  .hero p{color:#a9b6d2;font-size:18px;margin-bottom:28px;max-width:520px}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
  .hero .carousel{height:440px;background:#152549}
  .hero .car-track{height:100%}
  .hero .ph{background:repeating-linear-gradient(45deg,#1a2c55,#1a2c55 12px,#152549 12px,#152549 24px);border:none;color:#7d8db3}
  .ticks{display:flex;gap:22px;margin-top:26px;flex-wrap:wrap;font-size:14px;color:#bcc7dd;font-weight:600}
  .ticks li{list-style:none;display:flex;gap:8px;align-items:center}
  .tick{color:var(--accent);font-weight:800}

  /* press strip */
  .press{background:var(--paper);border-bottom:1px solid var(--line);padding:28px 0}
  .press .wrap{display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap}
  .press small{width:100%;text-align:center;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;font-weight:700;font-size:11px;margin-bottom:6px}
  .press .ph{height:44px;width:130px;font-size:12px}

  /* problem */
  .problem{background:var(--card)}
  .problem .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
  .problem .ph{min-height:340px}
  .xlist li{list-style:none;margin:14px 0;padding-left:34px;position:relative;font-size:16.5px}
  .xlist li::before{content:"✕";position:absolute;left:0;top:1px;width:24px;height:24px;border-radius:50%;background:#fdeaea;color:#c0392b;font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}

  /* how it works */
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:44px}
  .step{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:30px 26px;text-align:center}
  .step .num{width:44px;height:44px;border-radius:50%;background:var(--accent);color:var(--accent-ink);font-weight:800;font-size:18px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
  .step .ph{height:150px;margin-bottom:18px}
  .step h3{font-size:19px;margin-bottom:8px}
  .step p{color:var(--muted);font-size:15px}

  /* features */
  .features{background:var(--ink-soft);color:#fff}
  .features .sub{color:#a9b6d2}
  .fgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:44px}
  .fcard{background:#1a2c55;border:1px solid #26396b;border-radius:var(--radius);padding:28px}
  .fcard .ico{width:48px;height:48px;border-radius:12px;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px}
  .fcard h3{font-size:19px;margin-bottom:8px}
  .fcard p{color:#a9b6d2;font-size:15px}
  .fcard .ph-txt{background:rgba(255,176,32,.15);color:#ffcb66}

  /* comparison */
  .compare table{width:100%;border-collapse:collapse;margin-top:40px;background:var(--card);border-radius:var(--radius);overflow:hidden;box-shadow:0 10px 30px rgba(10,22,48,.07)}
  .compare th,.compare td{padding:16px 18px;text-align:center;font-size:15px;border-bottom:1px solid var(--line)}
  .compare th{font-size:15.5px}
  .compare td:first-child,.compare th:first-child{text-align:left;font-weight:600}
  .compare th.us{background:var(--ink);color:var(--accent)}
  .compare td.us{background:var(--accent-soft);font-weight:700;color:var(--ink)}
  .yes{color:var(--green);font-weight:800}
  .no{color:#c0392b;font-weight:800}

  /* reviews carousel */
  .reviews{background:var(--paper)}
  .rev-car{position:relative;margin-top:44px}
  .rev-track{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:4px;scrollbar-width:none}
  .rev-track::-webkit-scrollbar{display:none}
  .rcard{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px;flex:0 0 calc((100% - 48px)/3);scroll-snap-align:start}
  .rcard .stars{font-size:14px;margin-bottom:12px}
  .rcard .quote{font-size:15.5px;margin-bottom:18px}
  .rcard .who{display:flex;align-items:center;gap:12px;font-size:14px}
  .avatar{width:40px;height:40px;border-radius:50%;flex:none}
  .verified{color:var(--green);font-size:12.5px;font-weight:700}
  .rev-car .car-btn{background:var(--card);border:1px solid var(--line)}
  .rev-car .car-prev{left:-8px}
  .rev-car .car-next{right:-8px}

  /* guarantee */
  .guarantee{background:var(--blue);color:#fff}
  .guarantee .wrap{display:grid;grid-template-columns:auto 1fr;gap:44px;align-items:center;max-width:940px}
  .badge{width:150px;height:150px;border-radius:50%;background:#fff;color:var(--blue);display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;text-align:center;line-height:1.2;box-shadow:0 10px 30px rgba(0,0,0,.18)}
  .badge b{font-size:30px}
  .badge small{font-size:11px;letter-spacing:.06em;text-transform:uppercase}
  .guarantee p{color:#d6e0fb;font-size:17px;max-width:560px}
  .guarantee h2{color:#fff}
  .guarantee .ph-txt{background:rgba(255,255,255,.15);color:#ffd88a}

  /* buy box */
  .buy{background:var(--card)}
  .buy .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
  .gallery .carousel{height:400px;margin-bottom:14px;background:#eef2f9}
  .gallery .car-track{height:100%}
  .thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .thumbs .ph{height:80px;min-height:0;font-size:11px;padding:6px;cursor:pointer}
  .price-row{display:flex;align-items:baseline;gap:14px;margin:16px 0}
  .price{font-size:34px;font-weight:800;color:var(--ink)}
  .was{font-size:20px;color:var(--muted);text-decoration:line-through}
  .save{background:var(--accent-soft);color:var(--accent-dark);font-weight:700;font-size:13px;padding:4px 10px;border-radius:999px}
  .buy-ticks{margin:20px 0 26px}
  .buy-ticks li{list-style:none;margin:10px 0;padding-left:30px;position:relative;font-size:15.5px}
  .buy-ticks li::before{content:"✓";position:absolute;left:0;top:1px;width:22px;height:22px;border-radius:50%;background:var(--accent-soft);color:var(--accent-dark);font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}
  .btn-block{width:100%;text-align:center;font-size:18px;padding:18px}
  .payments{margin-top:16px}
  .payments .ph{height:34px;font-size:11px}

  /* faq */
  .faq{max-width:760px;margin:44px auto 0}
  details{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);margin-bottom:12px;overflow:hidden}
  summary{cursor:pointer;font-weight:700;font-size:16.5px;padding:20px 24px;list-style:none;position:relative}
  summary::after{content:"+";position:absolute;right:22px;top:16px;font-size:24px;color:var(--accent-dark);font-weight:400}
  details[open] summary::after{content:"–"}
  details .a{padding:0 24px 20px;color:var(--muted);font-size:15.5px}

  /* final cta */
  .final{background:var(--ink);color:#fff;text-align:center}
  .final h2{color:#fff;font-size:clamp(28px,4.5vw,44px)}
  .final p{color:#a9b6d2;max-width:560px;margin:0 auto 30px}

  /* footer */
  footer{background:#060d1f;color:#93a0bd;padding:56px 0 32px;font-size:14px}
  .fcols{display:grid;grid-template-columns:2fr 1fr 1fr 1.4fr;gap:40px;margin-bottom:40px}
  footer h4{color:#fff;font-size:14px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:16px}
  footer li{list-style:none;margin:9px 0}
  footer a:hover{color:#fff}
  footer .logo em{color:var(--accent)}
  .news input{width:100%;padding:12px 14px;border-radius:8px;border:1px solid #26396b;background:#0d1834;color:#fff;margin-bottom:10px;font-size:14px}
  .copy{border-top:1px solid #16223f;padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px}

  @media(max-width:860px){
    section{padding:52px 0}
    .hero .wrap,.problem .wrap,.buy .wrap{grid-template-columns:1fr;gap:36px}
    .steps{grid-template-columns:1fr}
    .fgrid{grid-template-columns:1fr}
    .rcard{flex:0 0 86%}
    .guarantee .wrap{grid-template-columns:1fr;text-align:center}
    .badge{margin:0 auto}
    .fcols{grid-template-columns:1fr 1fr}
    .nav-links{display:none}
    .hero .carousel{height:320px}
    .compare{overflow-x:auto}
    .rev-car .car-prev{left:6px}
    .rev-car .car-next{right:6px}
  }
</style>


