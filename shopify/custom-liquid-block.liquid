  <header class="ms-navbar">
    <div class="ms-container ms-navbar-inner">
      <a href="#ms-top" class="ms-logo">STORE NAME HERE</a>
      <nav class="ms-nav-links">
        <a href="#ms-top">Home</a>
        <a href="#ms-product">Shop</a>
        <a href="#ms-about">About</a>
        <a href="#ms-faq">FAQ</a>
        <a href="#ms-contact">Contact</a>
      </nav>
      <a href="/cart" class="ms-cart-link" aria-label="View cart">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="ms-cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </header>

  <!-- ============ HERO ============ -->
