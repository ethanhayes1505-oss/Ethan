<div class="page-width section">
  <div class="page-hero" style="padding-top: 0;">
    <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
    {%- assign order_date = order.created_at | date: format: 'date_at_time' -%}
    <p>{{ 'customer.order.date_html' | t: date: order_date }}</p>
    <p><a href="{{ routes.account_url }}" class="text-link">{{ 'customer.account.return' | t }}</a></p>
  </div>

  <table class="account-table">
    <thead>
      <tr>
        <th>{{ 'customer.order.product' | t }}</th>
        <th>{{ 'customer.order.quantity' | t }}</th>
        <th>{{ 'customer.order.price' | t }}</th>
        <th>{{ 'customer.order.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>{{ line_item.title }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_price | money }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3">{{ 'customer.order.subtotal' | t }}</td>
        <td>{{ order.line_items_subtotal_price | money }}</td>
      </tr>
      {%- for shipping_method in order.shipping_methods -%}
        <tr>
          <td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
          <td>{{ shipping_method.price | money }}</td>
        </tr>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <tr>
          <td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
          <td>{{ tax_line.price | money }}</td>
        </tr>
      {%- endfor -%}
      <tr>
        <td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td>
        <td><strong>{{ order.total_price | money }}</strong></td>
      </tr>
    </tfoot>
  </table>

  <div class="image-with-text" style="margin-top: 4.8rem; align-items: start;">
    <div>
      <h3>{{ 'customer.order.billing_address' | t }}</h3>
      {{ order.billing_address | format_address }}
    </div>
    <div>
      <h3>{{ 'customer.order.shipping_address' | t }}</h3>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</div>
