<div class="page-width section">
  <div class="page-hero" style="padding-top: 0;">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <p>
      {{ customer.name }} &middot;
      <a href="{{ routes.account_addresses_url }}" class="text-link">{{ 'customer.account.view_addresses' | t }}</a> &middot;
      <a href="{{ routes.account_logout_url }}" class="text-link">{{ 'customer.log_out' | t }}</a>
    </p>
  </div>

  <h3>{{ 'customer.orders.title' | t }}</h3>
  {%- if customer.orders.size > 0 -%}
    {%- paginate customer.orders by 20 -%}
      <table class="account-table">
        <thead>
          <tr>
            <th>{{ 'customer.orders.order_number' | t }}</th>
            <th>{{ 'customer.orders.date' | t }}</th>
            <th>{{ 'customer.orders.payment_status' | t }}</th>
            <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
            <th>{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}" class="text-link">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: format: 'abbreviated_date' }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- else -%}
    <p>{{ 'customer.orders.none' | t }}</p>
  {%- endif -%}
</div>
