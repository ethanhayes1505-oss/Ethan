{%- comment -%}
  Renders a product card.
  Accepts:
    card_product: product object (may be blank in the editor)
    placeholder_index: number used to vary the placeholder image
{%- endcomment -%}
<div class="product-card">
  <a href="{{ card_product.url | default: '#' }}">
    <div class="product-card__media">
      {%- if card_product.featured_image -%}
        {{ card_product.featured_image
          | image_url: width: 900
          | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: card_product.featured_image.alt | escape }}
      {%- else -%}
        {%- assign idx = placeholder_index | default: 1 -%}
        {%- assign placeholder = 'product-apparel-' | append: idx -%}
        {{ placeholder | placeholder_svg_tag }}
      {%- endif -%}
      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif card_product.available == false -%}
        <span class="product-card__badge">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>
    <h3 class="product-card__title">
      {{ card_product.title | default: 'Product title' }}
    </h3>
    <div class="product-card__price">
      {%- if card_product != blank -%}
        {% render 'price', product: card_product %}
      {%- else -%}
        <span class="price">{{ 4500 | money }}</span>
      {%- endif -%}
    </div>
  </a>
</div>
